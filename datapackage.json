  "resources": [
    {
      "name": "theyyam-wikidata",
      "path": "data/theyyam-wikidata.csv",
      "title": "Theyyams with a Wikidata item",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "dialect": {
        "delimiter": ",",
        "header": true,
        "lineTerminator": "\n"
      },
      "schema": {
        "fields": [
          {
            "name": "wikidata_id",
            "title": "Wikidata ID",
            "type": "string",
            "format": "default",
            "description": "Wikidata item ID. Resolve as https://www.wikidata.org/wiki/<id>.",
            "constraints": {
              "required": true,
              "unique": true,
              "pattern": "^Q[1-9][0-9]*$"
            },
            "rdfType": "http://wikiba.se/ontology#Item"
          },
          {
            "name": "name_ml",
            "title": "Malayalam name",
            "type": "string",
            "description": "Name of the theyyam in Malayalam script.",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "name_en",
            "title": "English name",
            "type": "string",
            "description": "Romanised English name. Spellings vary between sources; this is one common form.",
            "constraints": {
              "required": true
            }
          }
        ],
        "primaryKey": [
          "wikidata_id"
        ]
      }
    }
  ]
}